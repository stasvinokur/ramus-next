<?xml version="1.0" encoding="utf-8"?>
<jnlp spec="1.0+"
      codebase="http://stolit.dyndns.biz:8080/ramus/download/"
      href="ramus-http-client.jnlp">

    <icon href="about.png" kind="splash"/>

    <security>
        <all-permissions/>
    </security>

    <information>
        <title>Ramus Next Http Client Application</title>
        <vendor>Ramus Next Project</vendor>
        <description>Ramus Next Client Application with http hessian protocol</description>
        <homepage href="https://github.com/stasvinokur/ramus-next"/>
        <description kind="short">Програмне забезпечення для редагування класифікаторів,
            моделювання бізнес-процесів, тощо.
        </description>
        <offline-allowed/>
    </information>
    <resources>
        <jar href="ramus-client.jar"/>
        <jar href="../../ramus-web/download/ramus-web-client.jar"/>
        <j2se version="1.6+"
              href="http://java.sun.com/products/autodl/j2se"/>
    </resources>
    <application-desc main-class="com.ramussoft.client.WebStartClient"/>
</jnlp>
